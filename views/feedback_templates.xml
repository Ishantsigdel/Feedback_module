<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="s_feedback_module" name="Feedback Page">
        <section>
            <!-- <t t-call="website.layout"> -->
                <div class="container mt-5">
                    <h2>Leave Feedback</h2>
                    <form action="/submit_feedback" method="POST">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="form-group mb-5 ">
                            <input type="text" name="name" class="form-control" placeholder="Your Name" required="required"/>
                        </div>
                        <div class="form-group mb-5">
                            <input type="email" name="email" class="form-control" placeholder="Your Email" required="required"/>
                        </div>
                        <div class="form-group mb-5">
                            <textarea name="message" class="form-control" placeholder="Your Feedback" required="required"></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary mb-5">Submit</button>
                    </form>
                </div>
            <!-- </t> -->
        </section>
    </template>

    <template id="thank_you_template" name="Thank You Page">
        <!-- <t t-call="website.layout"> -->
        <section>
            <div class="container mt-5">
                <h2>Thank You!</h2>
                <p>Your feedback has been submitted.</p>
            </div>
        <!-- </t> -->
        </section>
    </template>
</odoo>



