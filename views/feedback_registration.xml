<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Register the snippet in website builder -->
    <template id="feedback_registration" inherit_id="website.snippets">
        <xpath expr="//div[@id='snippet_structure']/div[@class='o_panel_body']" position="inside">
            <t t-snippet="feedback_module.s_feedback_module" string="Feedback "/>
        </xpath>
    </template>
</odoo> 