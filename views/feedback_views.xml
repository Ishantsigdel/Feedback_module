<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_feedback_tree" model="ir.ui.view">
        <field name="name">my.module.feedback.tree</field>
        <field name="model">my.module.feedback</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="email"/>
            </tree>
        </field>
    </record>


    <record id="view_feedback_form" model="ir.ui.view">
        <field name="name">my.module.feedback.form</field>
        <field name="model">my.module.feedback</field>
        <field name="arch" type="xml">
            <form string="Feedback Form">
                <group>
                    <field name="name"/>
                    <field name="email"/>
                    <field name="message"/>
                </group>

            </form>
        </field>
    </record>

    <record id="view_feedback_kanban" model="ir.ui.view">
        <field name="name">my.module.feedback.kanban</field>
        <field name="model">my.module.feedback</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <strong>
                                <field name="name"/>
                            </strong>
                            <!-- <div>
                                        <field name="feedback"/>
                                    </div> -->
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <record id="action_feedback_module" model="ir.actions.act_window">
        <field name="name">Feedback</field>
        <field name="res_model">my.module.feedback</field>
        <field name="view_mode">tree,form,kanban</field>
    </record>


    <menuitem id="menu_feedback_root" name="Feedback"/>
    <menuitem id="menu_feedback_main" name="Feedback Entries" parent="menu_feedback_root" action="action_feedback_module"/>






</odoo>